cask "clipnest" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/@OWNER@/@REPO@/releases/download/v#{version}/clipnest-#{version}-macos.zip"
  name "clipnest"
  desc "剪贴板历史管理器，自带 NAS 同步"
  homepage "https://github.com/@OWNER@/@REPO@"

  app "clipnest.app"

  # 本项目没有购买 Apple Developer Program，因此没有公证（notarization）。
  # 下载来的 zip 带 com.apple.quarantine 属性，Gatekeeper 会把未公证的 app 拦下来
  # （「无法验证开发者」或「已损坏」）。cask 装完后删掉这个属性即可正常启动——
  # 官方 homebrew-cask 要求已公证，所以本 cask 只能放在自建 tap 里。
  postflight do
    system_command "/usr/bin/xattr",
                   args: ["-dr", "com.apple.quarantine", "#{appdir}/clipnest.app"]
  end

  # brew uninstall --zap：数据全在数据目录里，另有开机自启的 LaunchAgent
  # （设置窗里开关；关掉的话这个 plist 本来就不存在，zap 会跳过）。
  zap trash: [
    "~/Library/Application Support/clipnest",
    "~/Library/LaunchAgents/com.example.clipnest.plist",
  ]
end
